# --- Server ---
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# --- Database ---
# 'sqlite' runs the database inside the API process: nothing to install or
# start, which is the sensible default for local development.
# 'mysql' is the production path and uses the DB_HOST settings below.
DB_CLIENT=sqlite
DB_FILE=data/pathaura.sqlite

# --- Only used when DB_CLIENT=mysql ---
DB_HOST=127.0.0.1
DB_PORT=3310
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=pathaura

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20
