{
  "name": "pathaura",
  "version": "0.1.0",
  "private": true,
  "description": "PathAura — from learning a skill to getting work. Run every part of the project from here.",
  "scripts": {
    "start": "node scripts/dev.js",
    "dev": "node scripts/dev.js",
    "stop": "node scripts/stop.js",
    "setup": "npm --prefix server install && npm --prefix client install",
    "api": "npm --prefix server start",
    "api:watch": "npm --prefix server run dev",
    "web": "npm --prefix client run dev",
    "db:migrate": "npm --prefix server run db:migrate",
    "db:seed": "npm --prefix server run db:seed",
    "db:seed:demo": "npm --prefix server run db:seed:demo",
    "db:reset": "npm --prefix server run db:reset",
    "db:reset:demo": "npm --prefix server run db:reset:demo",
    "build": "npm --prefix client run build",
    "test": "npm --prefix server run test:security",
    "test:security": "npm --prefix server run test:security",
    "test:smoke": "npm --prefix server run test:smoke",
    "db:mysql": "npm --prefix server run db:start"
  },
  "workspaces": [],
  "engines": {
    "node": ">=18"
  }
}
